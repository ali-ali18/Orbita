{
	"name": "orbita",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev:api": "pnpm --filter @orbita/api dev",
		"dev:worker": "pnpm --filter @orbita/worker dev",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:generate": "pnpm --filter @orbita/db generate",
		"db:migrate": "pnpm --filter @orbita/db migrate:dev",
		"db:deploy": "pnpm --filter @orbita/db migrate:deploy",
		"parear": "pnpm --filter @orbita/api parear"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
