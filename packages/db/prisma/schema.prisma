generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Aparelho pareado com este servidor. O token fica só como hash.
model Device {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  pluggyConnectSessions PluggyConnectSession[]
  idempotencyKeys       IdempotencyKey[]

  @@map("devices")
}

/// Código de pareamento de 6 dígitos. Só um fica ativo por vez.
model PairingCode {
  id        String    @id @default(cuid())
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([usedAt, expiresAt])
  @@map("pairing_codes")
}

// ---------------------------------------------------------------------------
// Dados financeiros. App de um usuário só (sem userId). Dinheiro em centavos (Int).
// Regras que o Prisma não expressa (valor > 0, dias 1..31, formatos) são CHECKs na migração.
// ---------------------------------------------------------------------------

enum AccountKind {
  checking
  savings
  wallet
  investment

  @@map("account_kind")
}

enum ClosingRule {
  closing_day_next
  closing_day_included

  @@map("closing_rule")
}

enum TransactionKind {
  expense
  income
  transfer
  card_payment
  refund
  investment
  redemption

  @@map("transaction_kind")
}

enum TransactionStatus {
  pending
  confirmed

  @@map("transaction_status")
}

enum TransactionSource {
  manual
  notification
  pluggy
  receipt
  import

  @@map("transaction_source")
}

enum RecurrenceKind {
  expense
  income

  @@map("recurrence_kind")
}

/// Conta (corrente, poupança, carteira, investimento).
model Account {
  id              String            @id @default(cuid())
  name            String
  kind            AccountKind
  /// ISPB do banco, para achar o logo.
  bankCode        String?           @map("bank_code")
  /// Origem do cadastro; com `externalId`, liga a conta ao que veio de fora (ex.: conta do Meu Pluggy).
  source          TransactionSource @default(manual)
  externalId      String?           @map("external_id")
  /// Saldo que o banco informou (conta BANK, `account.balance` da Pluggy), em centavos; pode ser negativo. Nulo: nunca informado.
  balanceCents    Int?              @map("balance_cents")
  balanceSyncedAt DateTime?         @map("balance_synced_at")
  archivedAt      DateTime?         @map("archived_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  transactions        Transaction[]    @relation("TransactionAccount")
  counterpartOf       Transaction[]    @relation("TransactionCounterpart")
  recurrences         Recurrence[]
  preferences         AppPreferences[] @relation("DefaultAccount")
  leftoverPreferences AppPreferences[] @relation("LeftoverAccount")
  goals               Goal[]
  incomeSources       IncomeSource[]

  @@unique([source, externalId])
  @@map("accounts")
}

model Card {
  id                String            @id @default(cuid())
  name              String
  bankCode          String?           @map("bank_code")
  last4             String?
  closingDay        Int               @map("closing_day")
  dueDay            Int               @map("due_day")
  closingRule       ClosingRule       @default(closing_day_next) @map("closing_rule")
  /// De onde vem `closingRule`: "default", "inferred" (deduzida pelo sync das faturas do banco) ou "owner" (o dono escolheu; o sync nunca muda).
  closingRuleSource String            @default("default") @map("closing_rule_source")
  limitCents        Int?              @map("limit_cents")
  /// Limite disponível que o banco informou (`creditData.availableCreditLimit`), em centavos. Nulo: nunca informado.
  availableCents    Int?              @map("available_cents")
  /// Saldo do cartão que o banco informou (`balance` da conta CREDIT; em conector não Open Finance, a fatura aberta não paga), em centavos.
  balanceCents      Int?              @map("balance_cents")
  limitSyncedAt     DateTime?         @map("limit_synced_at")
  /// Origem do cadastro; com `externalId`, liga o cartão ao que veio de fora (ex.: cartão do Meu Pluggy).
  source            TransactionSource @default(manual)
  externalId        String?           @map("external_id")
  archivedAt        DateTime?         @map("archived_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  transactions Transaction[]
  recurrences  Recurrence[]
  bills        CardBill[]

  @@unique([source, externalId])
  @@map("cards")
}

model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  /// Índice em `chart.series` (0..9). Nulo: a tela usa a cor do slug.
  chartSlot  Int?      @map("chart_slot")
  isSystem   Boolean   @default(false) @map("is_system")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  transactions Transaction[]
  recurrences  Recurrence[]
  rules        CategoryRule[]

  @@map("categories")
}

/// Regra aprendida com a correção do dono: descrição que contém `pattern` (já normalizado) vai para `categoryId`.
model CategoryRule {
  id         String   @id @default(cuid())
  pattern    String   @unique
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("category_rules")
}

model Transaction {
  id                    String            @id @default(cuid())
  kind                  TransactionKind
  /// Sempre positivo; o sentido vem de `kind`.
  amountCents           Int               @map("amount_cents")
  date                  DateTime          @db.Date
  description           String
  categoryId            String?           @map("category_id")
  accountId             String?           @map("account_id")
  cardId                String?           @map("card_id")
  /// Destino de uma transferência.
  counterpartAccountId  String?           @map("counterpart_account_id")
  refundOfId            String?           @map("refund_of_id")
  budgetMonth           String            @map("budget_month") @db.Char(7)
  /// Só compra/estorno no cartão.
  invoiceMonth          String?           @map("invoice_month") @db.Char(7)
  installmentGroupId    String?           @map("installment_group_id")
  installmentNumber     Int?              @map("installment_number")
  installmentCount      Int?              @map("installment_count")
  status                TransactionStatus @default(confirmed)
  source                TransactionSource @default(manual)
  externalId            String?           @map("external_id")
  note                  String?
  /// Categoria que o banco mandou (cadeia legível, ex.: "Transfer - PIX"). Só importados; nunca decide nada sozinha.
  sourceCategory        String?           @map("source_category")
  /// Nome do estabelecimento que o banco informou (quando informou).
  merchantName          String?           @map("merchant_name")
  /// O dono trocou a categoria à mão: regras novas não reclassificam este lançamento.
  categoryEditedByOwner Boolean           @default(false) @map("category_edited_by_owner")
  /// O dono mexeu no tipo, data, valor, conta ou cartão (ou revisou um pendente): sincronização e pareamento não o reescrevem.
  editedByOwner         Boolean           @default(false) @map("edited_by_owner")
  /// Partes de uma compra que o dono dividiu em categorias diferentes dividem este id. Sem unicidade: é só o agrupamento.
  splitGroupId          String?           @map("split_group_id")
  /// O banco ainda não efetivou (Pluggy `status: PENDING`: compra da fatura aberta do cartão). Não é o `status` de revisão ("Para revisar"): conta no gasto normalmente.
  bankPending           Boolean           @default(false) @map("bank_pending")
  /// `providerId` do Pluggy (id do lançamento no banco; só conectores Open Finance): âncora para reconhecer o mesmo lançamento recriado com id novo.
  providerId            String?           @map("provider_id")
  /// `providerCode` do Pluggy (código da instituição, ex. NSU; formato varia): âncora mais fraca, sempre com valor e data.
  providerCode          String?           @map("provider_code")
  /// Última sincronização em que o Pluggy trouxe este lançamento. Nulo = ainda não acompanhado (o relógio começa na primeira rodada).
  lastSeenAt            DateTime?         @map("last_seen_at")
  /// A sincronização notou que o banco parou de informar este lançamento (apagado, ou só marcado para revisão se o dono o editou). Limpo quando ele volta.
  removedByBankAt       DateTime?         @map("removed_by_bank_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  /// Exclusão lógica: some de listas e buscas, mas segura o (source, externalId).
  deletedAt             DateTime?         @map("deleted_at")

  category           Category?          @relation(fields: [categoryId], references: [id])
  account            Account?           @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  card               Card?              @relation(fields: [cardId], references: [id], onDelete: Restrict)
  counterpartAccount Account?           @relation("TransactionCounterpart", fields: [counterpartAccountId], references: [id], onDelete: Restrict)
  refundOf           Transaction?       @relation("Refund", fields: [refundOfId], references: [id])
  refunds            Transaction[]      @relation("Refund")
  posting            RecurrencePosting?
  goalContributions  GoalContribution[]
  alerts             Alert[]

  @@unique([source, externalId])
  @@unique([installmentGroupId, installmentNumber])
  @@index([splitGroupId])
  @@index([budgetMonth])
  @@index([cardId, invoiceMonth])
  @@index([date])
  @@index([status])
  @@index([installmentGroupId])
  @@index([providerId])
  @@index([providerCode])
  @@map("transactions")
}

model Recurrence {
  id              String         @id @default(cuid())
  kind            RecurrenceKind
  name            String
  amountCents     Int            @map("amount_cents")
  dayOfMonth      Int            @map("day_of_month")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  categoryId      String?        @map("category_id")
  accountId       String?        @map("account_id")
  cardId          String?        @map("card_id")
  /// "Lembrar 1 dia antes": só a escolha do dono; o aviso em si espera as notificações push existirem.
  remindDayBefore Boolean        @default(false) @map("remind_day_before")
  archivedAt      DateTime?      @map("archived_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category Category?           @relation(fields: [categoryId], references: [id])
  account  Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card     Card?               @relation(fields: [cardId], references: [id], onDelete: Restrict)
  postings RecurrencePosting[]

  @@map("recurrences")
}

/// A recorrência já virou lançamento neste mês. Um por (recorrência, mês).
model RecurrencePosting {
  id            String   @id @default(cuid())
  recurrenceId  String   @map("recurrence_id")
  month         String   @db.Char(7)
  transactionId String   @unique @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  recurrence  Recurrence  @relation(fields: [recurrenceId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([recurrenceId, month])
  @@map("recurrence_postings")
}

model Budget {
  id         String   @id @default(cuid())
  /// "total" ou o id de uma categoria.
  scope      String   @unique
  limitCents Int      @map("limit_cents")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("budgets")
}

/// Meta de guardar dinheiro. O guardado não é coluna: é a soma das contribuições (o engine calcula o resto).
model Goal {
  id          String    @id @default(cuid())
  name        String
  targetCents Int       @map("target_cents")
  /// Prazo (só o dia); null = sem prazo.
  deadline    DateTime? @db.Date
  /// Conta onde o dinheiro da meta está guardado (só informação).
  accountId   String?   @map("account_id")
  /// Nome do ícone (lista fixa em `@orbita/shared`).
  icon        String    @default("target")
  /// Índice em `chart.series` (0..9): a cor da meta.
  chartSlot   Int       @default(0) @map("chart_slot")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]
  preferences   AppPreferences[]   @relation("LeftoverGoal")

  @@map("goals")
}

/// Fonte de renda: o salário (recorrente) ou uma entrada avulsa (freela) de um mês. O plano do mês é do engine.
model IncomeSource {
  id          String    @id @default(cuid())
  name        String
  /// Líquido, em centavos.
  amountCents Int       @map("amount_cents")
  /// Dia do mês (1..31); em mês curto o engine cai no último dia.
  payday      Int
  /// Conta onde o dinheiro cai (só informação).
  accountId   String?   @map("account_id")
  /// true = todo mês; false = só em `month`.
  recurring   Boolean   @default(true)
  /// Mês da renda avulsa (AAAA-MM); nulo nas recorrentes.
  month       String?   @db.Char(7)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("income_sources")
}

/// Um "Guardar": valor somado ao guardado da meta. Opcionalmente aponta o lançamento que o originou (só referência).
model GoalContribution {
  id            String   @id @default(cuid())
  goalId        String   @map("goal_id")
  amountCents   Int      @map("amount_cents")
  date          DateTime @db.Date
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@map("goal_contributions")
}

/// Perfil, preferências e notificações do dono. App de um usuário só: uma única linha (id "main").
model AppPreferences {
  id                   String   @id @default("main")
  /// Como a Órbita chama o dono; null = sem nome.
  displayName          String?  @map("display_name")
  /// Conta já marcada em "Novo lançamento".
  defaultAccountId     String?  @map("default_account_id")
  defaultAccount       Account? @relation("DefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  /// Avisar quando o gasto de uma categoria (ou do mês) passar deste percentual do limite (1 a 100). O aviso por push
  /// ainda não existe: vale para o indicador dentro do app.
  budgetAlertPercent   Int      @default(80) @map("budget_alert_percent")
  /// Para onde vai a sobra do mês; null = nenhum destino. Só a escolha é guardada: nenhum dinheiro é movido.
  leftoverAccountId    String?  @map("leftover_account_id")
  leftoverAccount      Account? @relation("LeftoverAccount", fields: [leftoverAccountId], references: [id], onDelete: SetNull)
  /// Ou uma meta ativa (nunca os dois ao mesmo tempo). Também só a escolha: nenhum dinheiro é movido.
  leftoverGoalId       String?  @map("leftover_goal_id")
  leftoverGoal         Goal?    @relation("LeftoverGoal", fields: [leftoverGoalId], references: [id], onDelete: SetNull)
  /// Escolhas da tela Notificações do celular (a leitura das notificações de banco, no Android).
  notificationCapture  Boolean  @default(false) @map("notification_capture")
  notificationApps     String[] @default([]) @map("notification_apps")
  /// Guardar na lista "Não entendi" o que o parser não reconhece (desligado: descarta).
  notificationToReview Boolean  @default(true) @map("notification_to_review")
  /// O que o parser entendeu vai para "Para revisar" (true) em vez de entrar direto como "aguardando o banco" (false).
  notificationAskFirst Boolean  @default(false) @map("notification_ask_first")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_preferences")
}

/// Layout dos widgets do Início (ordem, tamanho e visibilidade). App de um usuário só: uma única linha (id "main").
/// `items` é uma lista `[{ id, size, visible }]`; o servidor a põe em dia com o catálogo de widgets a cada leitura.
model HomeLayout {
  id        String   @id @default("main")
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_layout")
}

/// Chave de API ou credencial colada no app, guardada cifrada (AES-GCM, AAD = nome). O valor nunca sai em claro nem em parte.
model ServerSecret {
  name       String   @id
  ciphertext String
  /// Nome do aparelho que gravou por último (cópia do nome na hora, não o id).
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("server_secrets")
}

/// Conexão do Meu Pluggy cadastrada pelo dono. O plano pessoal não lista conexões pela API: o id (itemId) é colado uma vez.
model PluggyConnection {
  /// O itemId do Pluggy (UUID).
  id                 String    @id
  label              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  /// Início da última sincronização que terminou sem erro (a próxima janela parte daqui).
  lastSyncAt         DateTime? @map("last_sync_at")
  /// Dia mais antigo (AAAA-MM-DD) que alguma sincronização boa já buscou. Nulo = nunca buscou os 6 meses: a próxima busca o histórico inteiro uma vez.
  historyFrom        String?   @map("history_from")
  /// "ok" | "partial" | "error" | "no_keys".
  lastStatus         String?   @map("last_status")
  /// Mensagem já sanitizada (sem segredo).
  lastError          String?   @map("last_error")
  /// O dono deu o nome (digitado ou renomeado): a sincronização não o troca mais.
  labelEditedByOwner Boolean   @default(false) @map("label_edited_by_owner")
  /// Contas e cartões que a última sincronização ligou a esta conexão (o Pluggy não guarda o vínculo item → conta no Órbita).
  accountCount       Int       @default(0) @map("account_count")
  cardCount          Int       @default(0) @map("card_count")
  /// O conector do item usa as APIs regulamentadas do Open Finance (`connector.isOpenFinance`). Nulo = ainda não visto. Diz se `providerId`, `operationType` e `billId` podem vir.
  isOpenFinance      Boolean?  @map("is_open_finance")

  @@map("pluggy_connections")
}

/// Sessão para conectar um banco pelo Pluggy Connect (página web do servidor). Token aleatório de uso único e vida curta; só o hash fica aqui.
model PluggyConnectSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  /// O aparelho que pediu a sessão: se for revogado, a sessão deixa de valer.
  deviceId     String    @map("device_id")
  /// Reconexão: o item que o Pluggy Connect deve ATUALIZAR (mesmo item, mesmos ids). Nulo = conexão nova.
  updateItemId String?   @map("update_item_id")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([usedAt, expiresAt])
  @@map("pluggy_connect_sessions")
}

/// Chave de idempotência (`Idempotency-Key`) de um pedido que cria algo: repetir o pedido devolve a resposta guardada em vez de criar de novo. Vale por aparelho e some depois de `expiresAt`.
model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  deviceId    String   @map("device_id")
  /// Hash de método + caminho + corpo: a mesma chave com outro pedido é recusada.
  requestHash String   @map("request_hash")
  /// Nulos enquanto o primeiro pedido ainda roda.
  status      Int?
  body        String?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Arquivo de extrato já importado (só o hash dele e os números do resultado; o arquivo nunca é guardado). Repetir o envio do mesmo arquivo para o mesmo destino não cria nada de novo.
model ImportBatch {
  id                     String   @id @default(cuid())
  /// SHA-256 (hex) dos bytes do arquivo.
  fileHash               String   @map("file_hash")
  /// "account:<id>" ou "card:<id>".
  targetKey              String   @map("target_key")
  format                 String
  createdAt              DateTime @default(now()) @map("created_at")
  /// Nulos enquanto a importação ainda roda.
  createdCount           Int?     @map("created_count")
  duplicateCount         Int?     @map("duplicate_count")
  possibleDuplicateCount Int?     @map("possible_duplicate_count")
  unrecognizedCount      Int?     @map("unrecognized_count")

  @@unique([fileHash, targetKey])
  @@map("import_batches")
}

/// Notificação de banco que não virou lançamento: formato que o parser não entendeu, ou cartão/conta que não achei. Só
/// estas guardam o texto (cortado e limpo); a que virou lançamento não deixa o texto no servidor. Idempotente por `key`
/// (hash de pacote + texto + minuto), a mesma que o lançamento usa como `externalId`.
model NotificationInbox {
  id        String   @id @default(cuid())
  key       String   @unique
  app       String
  title     String
  text      String
  /// "format" (não entendi) ou "target" (entendi, mas não achei o cartão ou a conta).
  reason    String
  postedAt  DateTime @map("posted_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notification_inbox")
}

/// Conversa com a Órbita (o chat). O histórico mora no servidor: o app só mostra.
model ChatConversation {
  id        String   @id @default(cuid())
  /// Primeiras palavras da primeira mensagem do dono.
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  /// Conversa aberta com um agente (persona e ferramentas dele); nulo = conversa com a Órbita.
  agentId String? @map("agent_id")

  agent     Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]
  proposals ChatProposal[]
  usage     AiUsage[]

  @@index([updatedAt])
  @@map("chat_conversations")
}

/// Uma mensagem da conversa. `cards` guarda o que o app desenha embaixo do texto (resultado de ferramenta, proposta).
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  /// Ordem dentro da conversa, a partir de 1.
  seq            Int
  /// "user" | "assistant".
  role           String
  text           String
  cards          Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@map("chat_messages")
}

/// Escrita que a IA propôs e que só vale depois que o dono confirma (nada é gravado antes).
model ChatProposal {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  /// "create_transaction" | "categorize_transaction" | "confirm_transaction".
  kind           String
  /// O que será feito (já validado) e o resumo mostrado no card.
  payload        Json
  /// "pending" | "confirmed" | "canceled" | "undone".
  status         String    @default("pending")
  /// O que foi feito ao confirmar (ids e valores anteriores), para o Desfazer.
  result         Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  alerts       Alert[]

  @@index([conversationId])
  @@map("chat_proposals")
}

/// Uma chamada ao modelo: tokens e custo (em micro-dólares, inteiro) para somar o gasto do mês.
model AiUsage {
  id               String   @id @default(cuid())
  /// A conversa some e o custo fica.
  conversationId   String?  @map("conversation_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @map("cache_read_tokens")
  cacheWriteTokens Int      @map("cache_write_tokens")
  /// Custo em micro-dólares (1 US$ = 1.000.000), arredondado para cima.
  costMicroUsd     Int      @map("cost_micro_usd")
  /// Mês (AAAA-MM, fuso de São Paulo) em que a chamada aconteceu.
  month            String
  createdAt        DateTime @default(now()) @map("created_at")

  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([month])
  @@map("ai_usage")
}

/// Configuração da IA: uma única linha (id "main"). Limite mensal em centavos de dólar; null = sem limite.
model AiSettings {
  id                   String   @id @default("main")
  monthlyLimitUsdCents Int?     @map("monthly_limit_usd_cents")
  /// Modelo escolhido no app; null = vale o padrão do servidor (CHAT_MODEL).
  chatModel            String?  @map("chat_model")
  /// Modelo rápido; "off" = desligado; null = padrão do servidor (CHAT_MODEL_FAST).
  chatModelFast        String?  @map("chat_model_fast")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

/// Agente: um da casa (`builtinKey` preenchido: Órbita, Vigia, Fechamento, Metas, Caça-assinatura, Cofrinho) ou um
/// criado pelo dono (`builtinKey` nulo, com instruções e ferramentas de leitura). O worker roda os ligados na agenda.
model Agent {
  id           String    @id @default(cuid())
  builtinKey   String?   @unique @map("builtin_key")
  name         String
  /// Só do dono: o que ele escreveu. Vale como pedido dele, sempre abaixo das regras do sistema.
  instructions String?
  /// Só do dono: nomes das ferramentas de LEITURA que o agente pode chamar.
  tools        String[]  @default([])
  enabled      Boolean   @default(false)
  /// "daily" | "weekly" | "monthly".
  frequency    String    @default("daily")
  /// Hora cheia (0 a 23) no fuso de São Paulo.
  runHour      Int       @default(8) @map("run_hour")
  /// Semanal: 0 (domingo) a 6. Mensal: 1 a 28. Diário: nulo.
  runDay       Int?      @map("run_day")
  /// Escolhas do agente; validadas com zod na API (`agentSettingsSchemas`).
  settings     Json      @default("{}")
  /// Modelo só deste agente (da lista permitida); nulo = o padrão do servidor.
  model        String?
  lastRunAt    DateTime? @map("last_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  alerts        Alert[]
  activities    AgentActivity[]
  conversations ChatConversation[]

  @@map("agents")
}

/// Achado de um agente. `dedupeKey` identifica o achado (ex.: "budget:<categoria>:2026-11:alert"): o par
/// (agente, chave) é único, então rodar de novo no mesmo período não duplica nem reabre o que o dono dispensou.
model Alert {
  id            String    @id @default(cuid())
  agentId       String    @map("agent_id")
  kind          String
  dedupeKey     String    @map("dedupe_key")
  title         String
  /// Texto-modelo, ou o reescrito pela IA (`wordedByAi`). Os números vêm sempre do engine.
  body          String
  wordedByAi    Boolean   @default(false) @map("worded_by_ai")
  /// Números do achado, em centavos inteiros.
  data          Json      @default("{}")
  /// "new" | "seen" | "dismissed".
  status        String    @default("new")
  proposalId    String?   @map("proposal_id")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  seenAt        DateTime? @map("seen_at")
  dismissedAt   DateTime? @map("dismissed_at")

  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  proposal    ChatProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([agentId, dedupeKey])
  @@index([status, createdAt])
  @@map("alerts")
}

/// Registro de atividades do agente Economia: o que ele fez SOZINHO (categorizar, cadastrar assinatura, criar limite,
/// marcar duplicata, criar meta), com o motivo, a evidência e o que o Desfazer precisa. `dedupeKey` identifica o achado:
/// o par (agente, chave) é único, então o mesmo achado nunca vira duas ações, e o que o dono desfez não volta sozinho.
model AgentActivity {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  /// "categorize_transaction" | "register_subscription" | "set_budget_limit" | "flag_duplicate" | "create_savings_goal".
  kind      String
  dedupeKey String    @map("dedupe_key")
  summary   String
  reason    String
  /// { transactionIds: string[] }
  evidence  Json      @default("{}")
  /// Estado anterior e ids criados, para o Desfazer.
  undo      Json      @default("{}")
  /// "done" | "undone".
  status    String    @default("done")
  createdAt DateTime  @default(now()) @map("created_at")
  undoneAt  DateTime? @map("undone_at")
  undoNote  String?   @map("undo_note")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dedupeKey])
  @@index([createdAt])
  @@map("agent_activities")
}

/// Fatura do cartão como o banco a informou (`GET /bills` da Pluggy). Gravada a cada sincronização, idempotente por (source, externalId).
model CardBill {
  id                  String            @id @default(cuid())
  cardId              String            @map("card_id")
  source              TransactionSource
  externalId          String            @map("external_id")
  closeDate           DateTime?         @map("close_date") @db.Date
  dueDate             DateTime          @map("due_date") @db.Date
  totalAmountCents    Int               @map("total_amount_cents")
  minimumPaymentCents Int?              @map("minimum_payment_cents")
  currency            String            @default("BRL")
  syncedAt            DateTime          @map("synced_at")

  card     Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  payments CardBillPayment[]

  @@unique([source, externalId])
  @@index([cardId, dueDate])
  @@map("card_bills")
}

/// Pagamento feito numa fatura (`payments[]` da Pluggy). Substituídos a cada gravação da fatura.
model CardBillPayment {
  id          String   @id @default(cuid())
  billId      String   @map("bill_id")
  /// Id do pagamento na Pluggy, quando ela informa.
  externalId  String?  @map("external_id")
  amountCents Int      @map("amount_cents")
  date        DateTime @db.Date

  bill CardBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("card_bill_payments")
}

/// Posição de investimento AGORA (uma linha por (source, externalId); a API só dá a posição atual, sem histórico). Nunca é apagada: sumiu da lista ou TOTAL_WITHDRAWAL vira `archivedAt`. Dinheiro em centavos inteiros; quantidade, cota e taxas em NUMERIC (nunca float).
model Investment {
  id                   String    @id @default(cuid())
  /// De onde veio ("pluggy").
  source               String
  /// O id da posição na fonte.
  externalId           String    @map("external_id")
  /// A conexão (itemId do Pluggy) que a trouxe. Sem chave estrangeira: remover a conexão não apaga o histórico.
  connectionId         String?   @map("connection_id")
  type                 String?
  subtype              String?
  name                 String?
  code                 String?
  isin                 String?
  currency             String?
  /// "ACTIVE", "PENDING", "TOTAL_WITHDRAWAL"…
  status               String?
  /// Saldo líquido atual.
  balanceCents         Int?      @map("balance_cents")
  /// Valor bruto.
  grossCents           Int?      @map("gross_cents")
  /// Valor aplicado (`amountOriginal`).
  investedCents        Int?      @map("invested_cents")
  /// Rendimento que o BANCO informou (costuma vir nulo: o engine deriva).
  profitCents          Int?      @map("profit_cents")
  withdrawableCents    Int?      @map("withdrawable_cents")
  incomeTaxCents       Int?      @map("income_tax_cents")
  financialTaxCents    Int?      @map("financial_tax_cents")
  quantity             Decimal?  @db.Decimal(28, 8)
  unitValue            Decimal?  @map("unit_value") @db.Decimal(28, 8)
  rate                 Decimal?  @db.Decimal(28, 8)
  rateType             String?   @map("rate_type")
  fixedAnnualRate      Decimal?  @map("fixed_annual_rate") @db.Decimal(28, 8)
  annualRate           Decimal?  @map("annual_rate") @db.Decimal(28, 8)
  lastMonthRate        Decimal?  @map("last_month_rate") @db.Decimal(28, 8)
  lastTwelveMonthsRate Decimal?  @map("last_twelve_months_rate") @db.Decimal(28, 8)
  /// Data de referência do valor.
  positionDate         DateTime? @map("position_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  issueDate            DateTime? @map("issue_date") @db.Date
  purchaseDate         DateTime? @map("purchase_date") @db.Date
  issuer               String?
  /// Última vez que a sincronização viu esta posição na lista.
  syncedAt             DateTime  @map("synced_at")
  archivedAt           DateTime? @map("archived_at")
  /// Leituras seguidas em que a posição não veio na lista da fonte (só arquiva com o mínimo exigido: lista vazia "ok" pode ser falha).
  missingReads         Int       @default(0) @map("missing_reads")
  /// Leituras de movimentações bem-sucedidas DEPOIS de a posição ser arquivada (o resgate final pode chegar atrasado: relê até ter o bastante).
  movementsClosedReads Int       @default(0) @map("movements_closed_reads")
  /// O dia (America/Sao_Paulo) da última leitura contada: no máximo uma por dia, para syncs manuais não queimarem o mínimo.
  movementsClosedReadDay DateTime? @map("movements_closed_read_day") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  snapshots    InvestmentSnapshot[]
  transactions InvestmentTransaction[]

  @@unique([source, externalId])
  @@index([connectionId])
  @@map("investments")
}

/// Retrato diário da posição (dia em America/Sao_Paulo): é o único histórico de saldo que existe, porque o Pluggy só dá a posição de agora. Só grava com saldo não nulo; refazer no mesmo dia sobrescreve.
model InvestmentSnapshot {
  id            String   @id @default(cuid())
  investmentId  String   @map("investment_id")
  day           DateTime @db.Date
  balanceCents  Int      @map("balance_cents")
  grossCents    Int?     @map("gross_cents")
  investedCents Int?     @map("invested_cents")
  quantity      Decimal? @db.Decimal(28, 8)
  unitValue     Decimal? @map("unit_value") @db.Decimal(28, 8)
  createdAt     DateTime @default(now()) @map("created_at")

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, day])
  @@index([day])
  @@map("investment_snapshots")
}

/// Movimentação de uma posição (aplicação, resgate, compra, venda…). A API não filtra por data: a idempotência é pelo (source, externalId).
model InvestmentTransaction {
  id             String    @id @default(cuid())
  investmentId   String    @map("investment_id")
  source         String
  externalId     String    @map("external_id")
  /// BUY, SELL, TAX, TRANSFER, INTEREST, AMORTIZATION.
  type           String?
  /// CREDIT ou DEBIT.
  movementType   String?   @map("movement_type")
  date           DateTime? @db.Date
  tradeDate      DateTime? @map("trade_date") @db.Date
  /// Valor bruto da operação, sem sinal (o sentido está em type/movementType).
  amountCents    Int?      @map("amount_cents")
  netAmountCents Int?      @map("net_amount_cents")
  quantity       Decimal?  @db.Decimal(28, 8)
  unitValue      Decimal?  @map("unit_value") @db.Decimal(28, 8)
  /// Texto do banco: dado, nunca instrução.
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([investmentId, date])
  @@map("investment_transactions")
}
