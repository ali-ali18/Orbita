# Copie para .env e preencha (no Dokploy, cole na aba "Environment").
# Nunca commite o .env. Gere cada segredo com o comando indicado.

# --- servidor (docker-compose.yml) ---
# Senhas do Postgres e do Redis entram em URLs de conexão. Gere com
# `openssl rand -hex 32`: base64 pode ter "/", "+" e "=", que quebram a URL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Segredo-mestre do servidor. As chaves de pareamento e de criptografia são
# derivadas dele; se trocar, os pareamentos existentes deixam de valer.
# Gere com: openssl rand -base64 48
APP_SECRET=
# Versão da imagem em ghcr.io/ali-ali18/orbita (latest, sha-abc1234, ...).
ORBITA_VERSION=latest
# Mostra o código de pareamento nos logs da API ao subir.
PAIRING_AUTO=true
# Quantos proxies confiáveis há na frente da API (para saber o IP real do cliente):
#   1 = Dokploy/Traefik direto na internet (padrão do compose)
#   2 = Cloudflare na frente do Traefik
#   0 = API exposta direto, ou desenvolvimento local (ignora X-Forwarded-For)
# Valor maior que o real deixa um atacante forjar o IP e fugir do limite de tentativas.
# padrão 1 no compose; use 2 com Cloudflare na frente (o Traefik precisa confiar nos IPs da Cloudflare)
# TRUSTED_PROXY_HOPS=2

# --- só para docker-compose.vps.yml (VPS sem painel) ---
# Domínio público; o Caddy tira o certificado HTTPS sozinho.
DOMAIN=financas.seudominio.dev

# --- desenvolvimento local (fora do compose) ---
DATABASE_URL=postgresql://orbita:orbita@localhost:5432/orbita
REDIS_URL=redis://:senha-local@localhost:6379
PORT=3000
# Local não tem proxy na frente: ignora X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
