# Copie para .env e preencha. Nunca commite o .env.

# --- docker compose (VPS) ---
# Senha do Postgres do compose. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=
# Domínio público da API; o Caddy tira o certificado HTTPS sozinho.
DOMAIN=financas.seudominio.dev

# --- comum ---
# Segredo do servidor, usado para assinar os códigos de pareamento.
# Gere com: openssl rand -base64 48
APP_SECRET=

# --- desenvolvimento local (fora do compose) ---
DATABASE_URL=postgresql://orbita:orbita@localhost:5432/orbita
REDIS_URL=redis://localhost:6379
PORT=3000
